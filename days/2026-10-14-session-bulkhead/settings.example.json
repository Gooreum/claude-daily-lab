{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_bulkhead.py\" hook",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_bulkhead.py\" end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
